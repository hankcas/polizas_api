# Copia este archivo como .env y llena los valores reales.
# El .env está en .gitignore: tus claves nunca llegan a GitHub.

# --- API de pólizas (Spring Boot en Render) ---
POLIZAS_API_URL=https://polizas-api-g8ew.onrender.com
POLIZAS_API_KEY=pon-aqui-la-api-key
# Segundos que esperamos cada intento antes de rendirnos
POLIZAS_API_TIMEOUT=30
# Intentos totales: Render gratis puede tardar hasta 2-3 minutos en despertar
POLIZAS_API_INTENTOS=5

# --- Modelo de lenguaje (LLM) ---
# Proveedor del LLM. Hoy: gemini. Cambiarlo solo exige un adaptador nuevo.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash
# Modelos de respaldo, separados por coma. Se usan si el principal agota su cuota
# gratuita (20 consultas al día por modelo) o está saturado. Vacío = sin respaldo.
LLM_MODELOS_RESPALDO=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Clave gratuita: https://aistudio.google.com/apikey
GEMINI_API_KEY=pon-aqui-tu-clave-de-gemini

# --- RAG sobre el PDF de condiciones generales (opcionales) ---
CONDICIONES_PDF=data/condiciones_generales.pdf
# Modelo de embeddings local (se descarga una vez, ~220 MB)
EMBEDDINGS_MODELO=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDINGS_CACHE=.cache/fastembed
